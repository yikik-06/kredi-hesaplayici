<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Kredi Hesaplayıcı</title>
<script src="https://cdn.tailwindcss.com"></script>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>body{font-family:'Plus Jakarta Sans',system-ui,sans-serif}input[type=range]{accent-color:#0f766e}</style>
</head>
<body class="min-h-screen bg-slate-100 text-slate-800">
<main class="mx-auto max-w-4xl px-4 py-10">
  <h1 class="text-3xl font-extrabold tracking-tight text-slate-900">Kredi Hesaplayıcı</h1>
  <p class="mt-1 text-slate-500">Aylık taksit, toplam geri ödeme ve ödeme planını anında gör.</p>

  <div class="mt-8 grid gap-6 md:grid-cols-5">
    <section class="md:col-span-2 rounded-3xl bg-white p-6 shadow-sm space-y-6">
      <div>
        <label class="flex justify-between text-sm font-semibold">Kredi tutarı <span id="tutarEt" class="text-teal-700"></span></label>
        <input id="tutar" type="number" min="1000" step="1000" value="100000" class="mt-2 w-full rounded-xl border border-slate-200 px-4 py-3 text-lg font-semibold focus:outline-none focus:ring-2 focus:ring-teal-600">
        <input id="tutarR" type="range" min="10000" max="2000000" step="5000" value="100000" class="mt-3 w-full">
      </div>
      <div>
        <label class="flex justify-between text-sm font-semibold">Vade (ay) <span id="vadeEt" class="text-teal-700"></span></label>
        <input id="vade" type="number" min="1" max="360" value="24" class="mt-2 w-full rounded-xl border border-slate-200 px-4 py-3 text-lg font-semibold focus:outline-none focus:ring-2 focus:ring-teal-600">
        <input id="vadeR" type="range" min="3" max="120" step="1" value="24" class="mt-3 w-full">
      </div>
      <div>
        <label class="text-sm font-semibold">Aylık faiz oranı (%)</label>
        <input id="faiz" type="number" min="0" step="0.01" value="3.19" class="mt-2 w-full rounded-xl border border-slate-200 px-4 py-3 text-lg font-semibold focus:outline-none focus:ring-2 focus:ring-teal-600">
      </div>
      <label class="flex items-start gap-3 rounded-xl bg-slate-50 p-3 text-sm">
        <input id="vergi" type="checkbox" checked class="mt-1 h-4 w-4 accent-teal-700">
        <span><b>KKDF ve BSMV ekle</b><br><span class="text-slate-500">Tüketici kredilerinde faize %30 vergi (%15 + %15) eklenir. Konut kredisinde kapatabilirsin.</span></span>
      </label>
    </section>

    <section class="md:col-span-3 space-y-6">
      <div class="rounded-3xl bg-teal-800 p-6 text-white shadow-sm">
        <p class="text-teal-100">Aylık taksit</p>
        <p id="taksit" class="mt-1 text-5xl font-extrabold tracking-tight">—</p>
        <div class="mt-6 grid grid-cols-2 gap-4 border-t border-teal-600 pt-4">
          <div><p class="text-sm text-teal-100">Toplam geri ödeme</p><p id="toplam" class="text-xl font-bold">—</p></div>
          <div><p class="text-sm text-teal-100">Toplam faiz ve vergi</p><p id="faizToplam" class="text-xl font-bold">—</p></div>
        </div>
        <div class="mt-5 h-3 w-full overflow-hidden rounded-full bg-teal-950/40">
          <div id="bar" class="h-full bg-amber-300" style="width:50%"></div>
        </div>
        <p class="mt-2 text-xs text-teal-100"><span class="inline-block h-2 w-2 rounded-full bg-teal-950/60"></span> Anapara &nbsp; <span class="inline-block h-2 w-2 rounded-full bg-amber-300"></span> Faiz ve vergi</p>
      </div>

      <div class="rounded-3xl bg-white p-6 shadow-sm">
        <h2 class="font-bold">Ödeme planı</h2>
        <div class="mt-3 max-h-80 overflow-auto rounded-xl border border-slate-100">
          <table class="w-full text-sm">
            <thead class="sticky top-0 bg-slate-50 text-left text-slate-500">
              <tr><th class="p-3">Ay</th><th class="p-3">Taksit</th><th class="p-3">Anapara</th><th class="p-3">Faiz+Vergi</th><th class="p-3">Kalan</th></tr>
            </thead>
            <tbody id="plan" class="divide-y divide-slate-100"></tbody>
          </table>
        </div>
      </div>
    </section>
  </div>
  <p class="mt-6 text-center text-xs text-slate-400">Sonuçlar tahminidir; bankanın nihai teklifi farklı olabilir.</p>
</main>

<script>
const $ = id => document.getElementById(id);
const tl = n => n.toLocaleString('tr-TR', {style:'currency', currency:'TRY', maximumFractionDigits:2});

function hesapla() {
  const P = parseFloat($('tutar').value) || 0;
  const n = Math.max(1, parseInt($('vade').value) || 1);
  let r = (parseFloat($('faiz').value) || 0) / 100;
  if ($('vergi').checked) r *= 1.30;

  const taksit = r === 0 ? P / n : P * r * Math.pow(1 + r, n) / (Math.pow(1 + r, n) - 1);
  const toplam = taksit * n;
  const faizVergi = toplam - P;

  $('tutarEt').textContent = tl(P);
  $('vadeEt').textContent = n + ' ay';
  $('taksit').textContent = tl(taksit);
  $('toplam').textContent = tl(toplam);
  $('faizToplam').textContent = tl(faizVergi);
  $('bar').style.width = (toplam > 0 ? faizVergi / toplam * 100 : 0) + '%';

  let kalan = P, rows = '';
  for (let i = 1; i <= n; i++) {
    const f = kalan * r;
    const ana = taksit - f;
    kalan = Math.max(0, kalan - ana);
    rows += `<tr><td class="p-3">${i}</td><td class="p-3">${tl(taksit)}</td><td class="p-3">${tl(ana)}</td><td class="p-3">${tl(f)}</td><td class="p-3">${tl(kalan)}</td></tr>`;
  }
  $('plan').innerHTML = rows;
}

// Kaydırma çubukları ile kutuları eşle
[['tutar','tutarR'],['vade','vadeR']].forEach(([a,b]) => {
  $(b).addEventListener('input', () => { $(a).value = $(b).value; hesapla(); });
  $(a).addEventListener('input', () => { $(b).value = $(a).value; hesapla(); });
});
$('faiz').addEventListener('input', hesapla);
$('vergi').addEventListener('change', hesapla);
hesapla();
</script>
</body>
</html>
